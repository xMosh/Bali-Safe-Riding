---
import Layout from '../layouts/Layout.astro';import Image from '../components/Image.astro';import Rich from '../components/Rich.astro';import content from '../data/content.json';
const base=import.meta.env.BASE_URL;
---
<Layout title="Scooter Tours"><section class="tours-hero"><Image page="scootertours" index={1} alt="" eager/><video autoplay muted loop playsinline preload="metadata" poster={base+'assets/531870_ea6d10284377437dba8753cabd7c5c7ef000.webp'} aria-label="Scooter tour through a Balinese village"><source src={base+'assets/tour-hero.mp4'} type="video/mp4"/></video><h1>Ride with us!</h1></section>
<section class="split tours-intro"><div class="copy center"><h2>Bali Scooter Tours</h2><h3 class="blue">For everyone</h3><Rich page="scootertours" index={2}/><a class="button" href="https://nomeo.io/c/SafeRidingBali/meetups">TOURS</a></div><div class="gallery" aria-label="Tour photo gallery">{[2,3,4,5,6,7].map(index=><button class="gallery-item" aria-label={'Enlarge tour photo '+(index-1)}><Image page="scootertours" index={index}/></button>)}</div></section>
<section class="tour-options wide"><div class="down-static">⌄</div><div class="three">{[[3,4,8],[5,6,9],[7,8,10]].map(([title,text,img])=><article class="center"><h3>{content.scootertours.rich[title].text}</h3><Rich page="scootertours" index={text}/><Image page="scootertours" index={img}/></article>)}</div></section>
<section class="aftermovies wide center"><div class="down-static">⌄</div><h2>Curious how we do it?</h2><h3 class="blue">Here are 2 aftermovies of past tours.</h3><div class="two">{[['Kintamani & Waterfall Tour','6RPa4_AAuhQ'],['Old Village & Waterfall Tour','7qRxq4KtVaY']].map(([name,id])=><article><h3 class="blue">{name}</h3><iframe src={'https://www.youtube-nocookie.com/embed/'+id} title={name} loading="lazy" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe><a href={'https://www.youtube.com/watch?v='+id}>Watch on YouTube ↗</a></article>)}</div></section>
<section class="split coffee"><div class="copy center"><h2>Coffee Secrets Tour</h2><Rich page="scootertours" index={13}/><a class="button" href="https://nomeo.io/meetup/1722829084672194">TOUR INFO</a></div><Image page="scootertours" index={11} alt="Coffee Secrets Tour — original tour information"/></section>
<section class="testimonials wrap center"><h2 class="blue">Testimonials</h2><div class="testimonial-frame"><article data-slide><p>Paulina - ⭐⭐⭐⭐⭐</p><div class="two"><Rich page="scootertours" index={16}/><Image page="scootertours" index={12} alt="Paulina's original tour review"/></div></article><article data-slide hidden><p>Galuh - ⭐⭐⭐⭐⭐</p><img src={base+'assets/galuh-feedback.webp'} alt="Galuh's original five-star tour review" loading="lazy"/></article></div><div class="slideshow-controls"><button data-prev aria-label="Previous testimonial">←</button><span data-slide-count aria-live="polite">1 / 2</span><button data-next aria-label="Next testimonial">→</button></div></section>
<dialog class="lightbox" aria-label="Tour photograph"><button class="close-lightbox" aria-label="Close photograph">×</button><img alt=""/></dialog>
<script>
const dialog=document.querySelector('dialog');document.querySelectorAll('.gallery-item').forEach(button=>button.addEventListener('click',()=>{const src=button.querySelector('img');const target=dialog?.querySelector('img');if(target&&src){target.src=src.src;target.alt=src.alt;dialog?.showModal()}}));document.querySelector('.close-lightbox')?.addEventListener('click',()=>dialog?.close());dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});
const slides=[...document.querySelectorAll('[data-slide]')];let slide=0;function show(n:number){slide=(n+slides.length)%slides.length;slides.forEach((el,i)=>{(el as HTMLElement).hidden=i!==slide});const count=document.querySelector('[data-slide-count]');if(count)count.textContent=`${slide+1} / ${slides.length}`;}document.querySelector('[data-prev]')?.addEventListener('click',()=>show(slide-1));document.querySelector('[data-next]')?.addEventListener('click',()=>show(slide+1));
</script></Layout>
