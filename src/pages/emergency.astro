---
import Layout from '../layouts/Layout.astro';import Image from '../components/Image.astro';import Rich from '../components/Rich.astro';import content from '../data/content.json';
const regions=[['Gianyar',[18,19]],['Denpassar',[20,21]],['Badung',[22]]];
const contacts=regions.map(([name,indices])=>({name,items:(indices as number[]).flatMap(index=>{
 const text=content.emergency.rich[index].text;
 return [...text.matchAll(/([^+]+)\+(\d[\d ]*\d)/g)].map(m=>({name:m[1].trim(),phone:'+'+m[2].replace(/\s/g,'')}));
})}));
---
<Layout title="Emergency"><section class="emergency-hero"><Image page="emergency" index={1} alt="" eager/><h1>In case of emergency</h1></section>
<div class="wrap emergency-body"><section class="center intro"><Rich page="emergency" index={1}/></section><div class="down-static">⌄</div>
<section class="three step-overview">{[[1,3,4,2,'secure'],[2,6,7,3,'call'],[3,9,10,4,'aid']].map(([n,title,text,img,id])=><a href={'#'+id} class="center"><span class="step-number">{n}</span><h3>{content.emergency.rich[title].text}</h3><Rich page="emergency" index={text}/><Image page="emergency" index={img} alt=""/></a>)}</section>
<section id="secure" class="outlined emergency-section"><h2><span class="step-number">1</span>Secure the location</h2><div class="step-detail"><Rich page="emergency" index={13}/><Image page="emergency" index={5} alt="Secure location icon"/></div></section>
<section id="call" class="emergency-section"><h2><span class="step-number">2</span>Call emergency help</h2><p class="center orange">(If nescessary)</p><div class="step-detail"><Rich page="emergency" index={17}/><Image page="emergency" index={6} alt="Emergency telephone icon"/></div>
<div class="region-tabs" role="tablist" aria-label="Choose your region">{contacts.map((region,i)=><button role="tab" id={'tab-'+i} aria-controls={'region-'+i} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1}>{region.name}</button>)}</div>
{contacts.map((region,i)=><div role="tabpanel" id={'region-'+i} aria-labelledby={'tab-'+i} class="contact-panel" hidden={i!==0}><ul>{region.items.map(item=><li><div><strong>{item.name}</strong><p>{item.phone}</p></div><a class="button" href={'tel:'+item.phone} aria-label={'Call '+item.name}>Call ☎</a></li>)}</ul></div>)}
<div class="disclaimer"><Rich page="emergency" index={23}/></div>
<iframe class="medical-map" src="https://www.google.com/maps/d/u/0/embed?mid=1lLmjErJKdCgdRcOjniqowNozlwldl3Q&ehbc=2E312F&noprof=1" title="Map of medical facilities in Bali" loading="lazy"></iframe></section>
<section id="aid" class="emergency-section"><h2><span class="step-number">3</span>Give First Aid</h2><div class="center"><Image page="emergency" index={7} alt="First aid icon" class="icon"/><Rich page="emergency" index={26}/></div><div class="three first-aid">{[[27,28],[29,30],[31,32]].map(([title,text])=><article><h3>{content.emergency.rich[title].text}</h3><Rich page="emergency" index={text}/></article>)}</div><div class="center goodluck"><Image page="emergency" index={8} alt="" class="icon"/><h2>Good Luck!</h2></div></section>
<section class="additional"><h2 class="blue center">Additional information</h2><div class="three"><article><h3 class="red-text">Donate blood</h3><Image page="emergency" index={9} alt="Blood donation icon" class="icon"/><Rich page="emergency" index={36}/><a class="button red" href="https://maps.app.goo.gl/nJz4MwVRfpdbv8yC6">Maps location ↗</a><Rich page="emergency" index={37}/></article><article><h3 class="blue">Further Info</h3><Rich page="emergency" index={39}/></article><article><h3>Corrections or improvements</h3><Rich page="emergency" index={41}/><form id="corrections" aria-label="Emergency Comment Form"><label>Your name *<input name="name" autocomplete="name" required/></label><label>Email *<input name="email" type="email" autocomplete="email" required/></label><label>Phone<input name="phone" type="tel" autocomplete="tel"/></label><label>Choose an issue<select name="issue"><option value="">Choose an issue</option><option>I have additional information</option><option>Mistaken information</option><option>Other</option></select></label><label>Comment<textarea name="comment" rows="5" placeholder="Give a detailed description, so we can check the information and correct/add where nescessary" required></textarea></label><button class="button" type="submit">Prepare email</button><p class="form-note">Opens your email app to send your comment to team@saferidingbali.com.</p><p id="form-status" role="status"></p></form></article></div></section></div>
<script>
const tabs=[...document.querySelectorAll<HTMLElement>('[role="tab"]')];function activate(i:number){tabs.forEach((tab,n)=>{tab.setAttribute('aria-selected',String(i===n));tab.tabIndex=i===n?0:-1;const panel=document.getElementById(tab.getAttribute('aria-controls')||'');if(panel)panel.hidden=i!==n})}tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(i));tab.addEventListener('keydown',e=>{let next=i;if(e.key==='ArrowRight')next=(i+1)%tabs.length;else if(e.key==='ArrowLeft')next=(i-1+tabs.length)%tabs.length;else if(e.key==='Home')next=0;else if(e.key==='End')next=tabs.length-1;else return;e.preventDefault();activate(next);tabs[next].focus()})});
document.querySelector<HTMLFormElement>('#corrections')?.addEventListener('submit',event=>{event.preventDefault();const data=new FormData(event.currentTarget as HTMLFormElement);const body=['Name: '+data.get('name'),'Email: '+data.get('email'),'Phone: '+data.get('phone'),'Issue: '+data.get('issue'),'','Comment:',String(data.get('comment'))].join('\n');const link='mailto:team@saferidingbali.com?subject='+encodeURIComponent('Emergency page: '+(data.get('issue')||'Comment'))+'&body='+encodeURIComponent(body);window.location.href=link;const status=document.querySelector('#form-status');if(status)status.textContent='Complete sending in your email app. If it did not open, email team@saferidingbali.com directly.'});
</script></Layout>
